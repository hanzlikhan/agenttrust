# AgentTrust API — local development environment.
# Copy to `.env` and fill in. Never commit a real `.env`.
# All values below are intentionally empty placeholders; the application
# defaults (documented beside each var) apply when a var is unset.
# This file covers every variable read by `apps/api/src/agenttrust_api/config.py`.

# SQLAlchemy URL for PostgreSQL (psycopg3 driver).
DATABASE_URL=

# Deployment environment label: local | test
AGENTTRUST_ENV=

# Bearer token that authorizes API key issuance / listing / revocation.
# Key management endpoints return 503 while this is empty (fail closed).
ADMIN_TOKEN=

# Comma-separated browser origins allowed to call the API (CORS).
# Default: http://localhost:3000
AGENTTRUST_CORS_ORIGINS=

# Default event retention window, in days (applied in a later phase).
# Default: 14
AGENTTRUST_EVENT_RETENTION_DAYS=

# --- SSE stream tuning (M08) ---
# Seconds between `: ping` heartbeats on idle streams. Default: 20.0
AGENTTRUST_SSE_HEARTBEAT_SECONDS=
# Seconds between polls of the durable events table. Default: 0.5
AGENTTRUST_SSE_POLL_SECONDS=
# Maximum seconds for a single SSE subscription; clients reconnect with
# Last-Event-ID and lose nothing. Default: 300.0
AGENTTRUST_SSE_MAX_SECONDS=

# --- Human approvals (M10) ---
# Seconds until a PENDING approval expires unless a reviewer decides it.
# Default: 900 (15 minutes)
AGENTTRUST_APPROVAL_TTL_SECONDS=

# --- Security hardening ---
# Rate limit: token-bucket refills per minute, per API key, enforced
# in-process (single-process limitation, ADR-039). Default: 60
AGENTTRUST_RATE_LIMIT_PER_MINUTE=

# --- Incident investigation (M11) ---
# Local Ollama base URL. No model is ever downloaded or required;
# the analyzer falls back to a deterministic template on any failure.
# Default: http://localhost:11434
AGENTTRUST_OLLAMA_URL=
# Local model to try first. Default: qwen2.5:3b
AGENTTRUST_OLLAMA_MODEL=
# Seconds before a single incident analysis attempt gives up and falls
# back to the deterministic template. Default: 30
AGENTTRUST_ANALYZE_TIMEOUT_SECONDS=

# --- Demo / example clients only (not read by the API itself) ---
# Used by examples/refund-support-agent/demo.py:
# AGENTTRUST_API_URL=http://localhost:8000
# AGENTTRUST_API_KEY=

# Public demo agent (Live Agent page). Server-side Groq key for the LLM loop.
# The /api/v1/agent/* endpoints are keyless but IP rate-limited.
GROQ_API_KEY=
AGENTTRUST_AGENT_MODEL=
AGENTTRUST_AGENT_RATE_LIMIT_PER_MINUTE=
